# =============================================================================
# Xaloqi EDS
# Kconfig
#
# Module-level Kconfig definitions: ISO-TP transport timing and padding,
# diagnostics task, watchdog window, key and ACL policy. Every symbol here is
# read by the code (build_tests.sh checks it, EDS#455). UDS session timing and
# the SecurityAccess lockout are configured in diagnostics_config.yaml, not
# here.
#
# USAGE: Override in prj.conf:
#   CONFIG_ISOTP_TIMEOUT_CR_MS=1000
#
# SAFETY: Parameter ranges are bounded to prevent accidental mis-configuration
#         that would violate ISO 15765-2 or ISO 14229-1 timing requirements.
# =============================================================================

# [SEC-DOIP-SEND-01] The DoIP bindings bound every send with SO_SNDTIMEO
# (DOIP_TCP_SEND_TIMEOUT_MS). On Zephyr that option is ignored unless
# net_context supports it, so turn it on by default for any socket build;
# transport/doip/zephyr_lwip.c refuses to build with it explicitly off.
configdefault NET_CONTEXT_SNDTIMEO
	default y if NET_SOCKETS

# [EDS#434, EDS#511] ECUReset on Zephyr calls sys_reboot(), on the CAN path
# (platform/zephyr/zephyr_port.c, zephyr_platform_api.c) and on the DoIP path
# (eds_platform_ecu_reset()). Without REBOOT that fails to link, so turn it on
# for every EDS Zephyr build, not only socket builds (#434 covered DoIP only).
# platform/zephyr/zephyr_port.c and transport/doip/zephyr_lwip.c refuse to
# build with it explicitly off.
configdefault REBOOT
	default y

menu "Xaloqi EDS"

# ---------------------------------------------------------------------------
# ISO-TP timing parameters (ISO 15765-2 §6.7)
# ---------------------------------------------------------------------------

config ISOTP_TX_PADDING
	bool "Enable ISO-TP transmit frame padding"
	default n
	help
	  Pad unused bytes in transmitted SF, FF (CAN FD escape), CF, and FC frames
	  to the maximum frame length: 8 bytes for Classic CAN, next valid CAN FD DLC
	  (12/16/20/24/32/48/64) for CAN FD. Unused bytes are filled with
	  CONFIG_ISOTP_TX_PADDING_BYTE (default 0xCC).
	  Required for interoperability with OEM diagnostic testers that expect
	  fixed-length frames. ISO 15765-2 Annex B permits but does not mandate this.
	  Receivers MUST ignore padding bytes per the standard.
	  Default n — DLC reflects only the bytes actually used.

config ISOTP_TX_PADDING_BYTE
	hex "ISO-TP TX padding byte value"
	default 0xCC
	depends on ISOTP_TX_PADDING
	help
	  Byte value used to fill unused frame bytes when ISOTP_TX_PADDING is enabled.
	  ISO 15765-2 Annex B recommends 0xCC. Override only if your OEM tester
	  requires a different padding byte.

config ISOTP_RX_PADDING_MODE
	int "ISO-TP receive Single Frame padding check"
	default 0
	range 0 2
	help
	  Which Classic CAN Single Frames are accepted (ISO 15765-2:2024
	  §9.6.2.2, §11.3.2). 0 (default): padded (CAN_DL 8) or optimised
	  (CAN_DL = SF_DL + 1). 1: padded only. 2: optimised only. Any other
	  Single Frame is ignored.

config ISOTP_TIMEOUT_CR_MS
	int "ISO-TP N_Cr timeout (ms)"
	default 1000
	range 25 1500
	help
	  Receiver: maximum wait for the next Consecutive Frame. ISO 15765-2:2024
	  Table 22 specifies 1000 ms as a lower limit; a conformant timeout fires
	  between 1000 and 1500 ms (§9.8.1). Values below 1000 are only for
	  networks whose specification mandates shorter timing (e.g. legislated
	  OBD profiles); they abort transfers with slower ISO 15765-2 peers.
	  [EDS#453] was 150 ms, and before EDS#453 this symbol was not read.

config ISOTP_TIMEOUT_BS_MS
	int "ISO-TP N_Bs timeout (ms)"
	default 1000
	range 25 1500
	help
	  Sender: maximum wait for a Flow Control frame after a First Frame or
	  block. ISO 15765-2:2024 Table 22: 1000 ms (lower limit). See
	  ISOTP_TIMEOUT_CR_MS for shorter values. [EDS#453] was 75 ms.

config ISOTP_TIMEOUT_AS_MS
	int "ISO-TP N_As timeout (ms)"
	default 1000
	range 10 1500
	help
	  Sender: maximum time for a CAN frame's transmission confirmation.
	  ISO 15765-2:2024 Table 22: 1000 ms (lower limit). [EDS#453] was 25 ms.

config ISOTP_TIMEOUT_AR_MS
	int "ISO-TP N_Ar timeout (ms)"
	default 1000
	range 10 1500
	help
	  Receiver: maximum time for the Flow Control frame's transmission
	  confirmation. ISO 15765-2:2024 Table 22: 1000 ms (lower limit).

# ---------------------------------------------------------------------------
# UDS session timing and SecurityAccess lockout are NOT Kconfig parameters.
# They come from diagnostics_config.yaml via codegen (GEN_S3_SERVER_TIMEOUT_MS,
# GEN_SAFETY_MAX_SA_ATTEMPTS, GEN_SAFETY_SA_LOCKOUT_MS). [EDS#455] The
# CONFIG_UDS_SESSION_S3_TIMEOUT_MS / _SECURITY_MAX_ATTEMPTS / _SECURITY_LOCKOUT_MS
# symbols that used to be here were never read; they are removed so a prj.conf
# that still sets them now gets a Kconfig warning naming the symbol ("attempt
# to assign ... to the undefined symbol") instead of being silently accepted.
# Zephyr warns, it does not fail the build.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Diagnostics task parameters
# ---------------------------------------------------------------------------

config DIAG_TASK_STACK_SIZE
	int "Diagnostics task stack size (bytes)"
	default 4096
	range 2048 16384
	help
	  Stack size for the diag_task_entry() Zephyr thread. Worst-case
	  measured stack usage (via -fstack-usage) is ~1600 bytes. The default
	  of 4096 bytes provides a 2.5x safety margin.
	  Increase if adding DID handlers with large local variable usage.

config DIAG_TASK_PRIORITY
	int "Diagnostics task thread priority"
	default 5
	range 0 14
	help
	  Zephyr cooperative thread priority. Lower number = higher priority.
	  Must be lower priority than the CAN ISR (priority 0) and higher than
	  the idle thread. Default of 5 is suitable for most configurations.

# ---------------------------------------------------------------------------
# Watchdog
# ---------------------------------------------------------------------------

config DIAG_WDT_WINDOW_MS
	int "Watchdog timeout window (ms)"
	default 100
	range 10 1000
	help
	  The hardware watchdog must be fed at least once within this window.
	  At 1 ms poll loop rate, 100 ms gives 100 iterations of slack.
	  Decrease for tighter safety monitoring; increase only if the poll
	  loop is intentionally extended (e.g. during flash programming).

# ---------------------------------------------------------------------------
# Security key management  [CRIT-4 FIX]
# ---------------------------------------------------------------------------

config DIAG_PLACEHOLDER_KEYS_ONLY
	bool "Allow placeholder AES-128 security keys (DEVELOPMENT ONLY)"
	default y
	help
	  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
	  WARNING: This option MUST be set to 'n' before any production build.
	  Leaving it 'y' means the UDS SecurityAccess algorithm uses publicly
	  known placeholder keys (0x00..0x0F / 0x10..0x1F).  Any person who
	  has downloaded the EDS source code can compute a valid key for any
	  seed and gain full diagnostic access to the ECU.
	  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

	  When set to 'n', the build fails at compile time with a #error if
	  the placeholder key pattern is detected in uds_security_algo.c.
	  OEM integration steps (required before setting this to 'n'):
	    1. Set CONFIG_DIAG_PLACEHOLDER_KEYS_ONLY=n in production prj.conf.
	    2. Before calling uds_generated_init(), inject real keys:
	         uds_security_algo_set_rng_cb(my_trng_cb);
	         uds_security_algo_set_level_key(0x01U, otp_key_level1_16bytes);
	         uds_security_algo_set_level_key(0x03U, otp_key_level2_16bytes);
	    3. Source keys from OTP fuses, HSM, or secure boot chain.
	       Do NOT commit real keys to source control.
	  The native_sim CI builds intentionally leave this 'y' so that
	  CI can compile and run functional tests without real keys.
	  TRACEABILITY: CRIT-4 / SEC-KEY-GATE-01

# ---------------------------------------------------------------------------
# Access control table  [#113 FIX]
# ---------------------------------------------------------------------------

config UDS_DTC_STATUS_AVAILABILITY_MASK
	hex "DTCStatusAvailabilityMask reported by ReadDTCInformation"
	default 0xFF
	range 0x00 0xFF
	help
	  The DTC status bits this ECU's monitors actually maintain (ISO
	  14229-1:2026 §11.3, Annex D.2). Reported in 0x19 responses, and request
	  status masks are processed using only these bits. Default 0xFF (all
	  eight). Clear the bits your application does not maintain. [EDS#451]

config UDS_ACL_ALLOW_UNLISTED_SERVICES
	bool "Permit UDS services with no access-table entry (NOT RECOMMENDED)"
	default n
	help
	  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
	  WARNING: leave this 'n' unless you have specifically audited every
	  service_id in your deployment that has no row in the active access
	  table (the built-in default table, or a custom one supplied via
	  uds_server_cfg_t.access_table) and decided it should be reachable
	  with NO session or security restriction at the ACL layer.
	  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

	  Prior to #113, a service_id with no matching row in the access table
	  was silently PERMITTED with no restriction at all — the ACL layer's
	  default was fail-open. That meant a new SID added to
	  service_registration.c (or to a custom table) without a matching ACL
	  row became fully accessible, in every session, with no security
	  check, purely by omission.

	  With this option left 'n' (the default), any service_id absent from
	  the active table is now DENIED — the server returns NRC 0x7F
	  (serviceNotSupportedInActiveSession) instead of dispatching the
	  handler. Set 'y' only to restore the pre-#113 permissive behaviour
	  for every unlisted service in your deployment; to allow just ONE
	  specific service with no ACL-layer restriction, add an explicit row
	  for that service_id to your table instead (see the SID 0x31
	  RoutineControl row in core/uds_access_table.c for a worked example)
	  and leave this option at its secure default.

	  FreeRTOS / bare-metal builds: define UDS_ACL_ALLOW_UNLISTED_SERVICES
	  (no CONFIG_ prefix) directly, e.g. -DUDS_ACL_ALLOW_UNLISTED_SERVICES=1.
	  TRACEABILITY: #113

# ---------------------------------------------------------------------------
# Build-configuration intent guards  [#498]
# ---------------------------------------------------------------------------

config EDS_REQUIRE_NEWLIB
	bool "Fail the build unless newlib is the C library"
	default n
	help
	  Set this next to CONFIG_NEWLIB_LIBC=y. Kconfig drops NEWLIB_LIBC=y
	  with only a warning when the toolchain has no newlib (Zephyr SDK
	  1.0.x, used by Zephyr 4.4, ships none), and the build then links
	  picolibc instead. With this option set, that swap fails the build
	  (platform/zephyr/zephyr_platform_api.c) instead of passing silently.
	  To accept picolibc on such a toolchain, set it to 'n' explicitly
	  together with CONFIG_NEWLIB_LIBC=n. native_sim (ARCH_POSIX) is exempt:
	  its host toolchain never has newlib.
	  TRACEABILITY: #498


config EDS_REQUIRE_STACK_CANARIES
	bool "Fail the build unless stack canaries are real"
	default n
	help
	  Set this next to CONFIG_STACK_CANARIES=y. Kconfig drops that request
	  with only a warning when the board has no entropy driver, because
	  STACK_CANARIES depends on ENTROPY_GENERATOR || TEST_RANDOM_GENERATOR.
	  With this option set, the build fails (platform/zephyr/
	  zephyr_platform_api.c) when:
	    - canaries were dropped;
	    - they are enabled only through TEST_RANDOM_GENERATOR, with no
	      entropy driver; or
	    - the chosen zephyr,entropy device is virtio-rng. Zephyr seeds the
	      canary after PRE_KERNEL_2 through entropy_get_entropy_isr(). The
	      virtio driver initialises at POST_KERNEL and has no ISR API, so the
	      canary would come from a k_cycle_get_32() fallback.
	  A board that cannot provide canaries says so explicitly:
	  CONFIG_STACK_CANARIES=n and CONFIG_EDS_REQUIRE_STACK_CANARIES=n.
	  On Zephyr 4.x the canary levels are members of an optional choice:
	  a later CONFIG_STACK_CANARIES=n does NOT undo an earlier fragment's
	  =y, and canaries stay on. Remove the =y instead, and check the final
	  build/zephyr/.config. Canaries with a virtio-rng zephyr,entropy are
	  refused even with this option set to n (#501).
	  native_sim (ARCH_POSIX) is exempt: it is a simulation, never shipped.

endmenu
