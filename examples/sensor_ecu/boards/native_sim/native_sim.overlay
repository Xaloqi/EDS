/*
 * =============================================================================
 * Xaloqi EDS
 * boards/native_sim/native_sim.overlay
 * examples/sensor_ecu/
 *
 * Device Tree overlay for native_sim (host simulation).
 *
 * Provides:
 *   - CAN loopback (same as all other examples)
 *   - Two stub sensor nodes, backed by a minimal out-of-tree driver that
 *     ships with this example (drivers/sensor_stub/, bound via
 *     dts/bindings/sensor/ -- see CMakeLists.txt's DTS_ROOT addition).
 *     [EDS#339] These return fixed nominal readings; native_sim has no
 *     physical sensor to simulate, and DTC firing/clearing is
 *     demonstrated via extreme thresholds (DID 0xD010/0xD011), not by
 *     varying the reading -- see sensor_monitor.c's header comment.
 *
 * On real hardware, replace these nodes with your physical sensor:
 *
 *   Temperature sensor examples:
 *     SHTC3 (I2C):   compatible = "sensirion,shtc3";
 *     LM75A (I2C):   compatible = "lm75";
 *     MCP9808 (I2C): compatible = "microchip,mcp9808";
 *     NTC on ADC:    compatible = "ntc-thermistor-generic";
 *
 *   Voltage sensor examples:
 *     INA219 (I2C):  compatible = "ti,ina219";
 *     ADC divider:   compatible = "voltage-divider";
 *
 * The aliases (temp-sensor-0, voltage-sensor-0) are the only coupling
 * between sensor_monitor.c and the board DTS. Change the alias target
 * to point at your physical sensor node and the application code is
 * unchanged.
 * =============================================================================
 */

/ {
    aliases {
        /* CAN loopback — same as basic_ecu */
        can0 = &can_loopback0;

        /*
         * Sensor aliases — sensor_monitor.c resolves devices by these names.
         * On native_sim: point to stub driver nodes below.
         * On hardware: point to the physical sensor node in your board DTS.
         */
        temp-sensor-0    = &temp_stub;
        voltage-sensor-0 = &voltage_stub;
    };

    /*
     * [EDS#339] Backed by drivers/sensor_stub/ambient_temp_stub.c — fixed
     * 25 degC reading. Previously used compatible = "zephyr,temperature-
     * stub", a string that both claimed in-tree Zephyr provenance it
     * didn't have and had no backing driver at all (undefined reference
     * to __device_dts_ord_N at link time). Renamed to an "xaloqi,"
     * compatible matching the binding this example actually ships.
     */
    temp_stub: temp-stub {
        compatible = "xaloqi,ambient-temp-stub";
        status = "okay";
    };

    /* [EDS#339] Same history and fix as temp_stub above. */
    voltage_stub: voltage-stub {
        compatible = "xaloqi,voltage-stub";
        status = "okay";
    };
};

&can_loopback0 {
    status = "okay";
    bus-speed = <500000>;
};
