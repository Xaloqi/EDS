/*
 * Xaloqi EDS — canfd_ecu
 * boards/native_sim/native_sim.overlay
 *
 * CAN loopback for native_sim simulation.
 * No sensor aliases needed: every DID is a generated constant except 0xF201 (src/main.c).
 * On real hardware, replace can0 alias with your CAN peripheral node.
 */
/ {
    aliases {
        can0 = &can_loopback0;
    };
};

&can_loopback0 {
    status = "okay";
    bitrate   = <500000>;
};
